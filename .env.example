# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GitHub OAuth App credentials (server-only, never prefix with VITE_)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional public URL for the separate control-plane readiness endpoint.
# Leave empty until a staging service is deployed; never put DATABASE_URL in VITE_*.
VITE_CONTROL_PLANE_URL=

# Server-only variables for services/control-plane (configure in hosting secrets, not frontend env).
# FIREBASE_PROJECT_ID=gen-lang-client-0367464144
# DATABASE_URL=
# PG_POOL_MAX=5
# PGSSL=verify-full
# PORT=8787
# CONTROL_PLANE_CORS_ORIGINS=https://your-staging-dashboard.example
